# Copy to .env and adjust. docker compose reads it automatically.
# Backend to run: spring | express | dotnet
BACKEND=spring
WEB_PORT=8080
JWT_SECRET=change-me-to-a-long-random-secret-of-32-bytes
DB_PASSWORD=dropzone
SIGNUP_CREDIT_CENTS=50000
ADMIT_BATCH=50
ADMIT_INTERVAL_MS=1000
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SEC=10
